          "format": "time_series",
          "rawSql": "SELECT date_time2 AS time, vehicle_num AS metric, net_weight AS value\n        FROM tickets\n        WHERE voyage IN (${voyage:sqlstring}) AND site IN (${site:sqlstring}) AND ticket_type IN (${ticket_type:sqlstring}) AND vehicle_num IN (${vehicle:sqlstring}) AND location IN (${bay:sqlstring}) AND $__timeFilter(date_time2)\n        ORDER BY date_time2",
