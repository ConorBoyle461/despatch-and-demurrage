    {
      "id": 11,
      "type": "table",
      "title": "Store (by bay) \u2014 this voyage's discharge",
      "datasource": {
        "type": "postgres",
        "uid": "afxbuc9yby1ogd"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "afxbuc9yby1ogd"
          },
          "format": "table",
          "rawSql": "SELECT\n            COALESCE(MAX(bc.store_name), t.location) AS store,\n            ROUND(SUM(t.net_weight)::numeric, 1) AS used,\n            MAX(bc.max_capacity) AS max_capacity,\n            ROUND((SUM(t.net_weight) / NULLIF(MAX(bc.max_capacity), 0) * 100)::numeric, 1) AS fill_pct\n        FROM tickets t\n        LEFT JOIN bay_capacity bc ON bc.site = t.site AND bc.bay = t.location\n        WHERE voyage IN (${voyage:sqlstring}) AND t.site IN (${site:sqlstring}) AND t.vehicle_num IN (${vehicle:sqlstring}) AND t.location IN (${bay:sqlstring}) AND t.ticket_type = 'VESSEL-IN' AND t.date_time2 <= $__timeTo()\n        GROUP BY t.site, t.location\n        ORDER BY store",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
