    {
      "id": 12,
      "type": "table",
      "title": "Vessel (loading) \u2014 no hatch-level data available",
      "datasource": {
        "type": "postgres",
        "uid": "afxbuc9yby1ogd"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "afxbuc9yby1ogd"
          },
          "format": "table",
          "rawSql": "SELECT\n            COALESCE(regexp_replace(location, '\\s*-\\s*VOY\\..*$', ''), location) AS vessel,\n            ROUND(SUM(net_weight)::numeric, 1) AS tons_loaded,\n            COUNT(*) AS tips\n        FROM tickets\n        WHERE voyage IN (${voyage:sqlstring}) AND site IN (${site:sqlstring}) AND vehicle_num IN (${vehicle:sqlstring}) AND ticket_type = 'OUT' AND date_time2 <= $__timeTo()\n        GROUP BY vessel\n        ORDER BY tons_loaded DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
