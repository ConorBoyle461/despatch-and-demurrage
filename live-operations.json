          "datasource": {
            "type": "postgres",
            "uid": "afxbuc9yby1ogd"
          },
          "format": "table",
          "rawSql": "SELECT COALESCE(\n            (SELECT string_agg(DISTINCT regexp_replace(location, '\\s*-\\s*VOY\\..*$', ''), ', ' ORDER BY regexp_replace(location, '\\s*-\\s*VOY\\..*$', ''))\n             FROM tickets WHERE voyage IN (${voyage:sqlstring}) AND ticket_type = 'OUT'),\n            '(no OUT tickets on the selected voyage(s) \u2014 vessel name unavailable)'\n        ) AS vessel_name",
          "refId": "A"
        }
